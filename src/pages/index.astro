---
const teamName = "DestinyForge";
const stats = [
  { value: "8", label: "développeurs" },
  { value: "3", label: "années de conception" },
  { value: "1", label: "vision commune" },
  { value: "∞", label: "ambition" },
];

const pillars = [
  {
    title: "Narration immersive",
    text: "Des mondes cohérents, des personnages profonds et des décisions qui façonnent le destin des joueurs.",
  },
  {
    title: "Gameplay addictif",
    text: "Des mécaniques accessibles, exigeantes et mémorables conçues pour offrir des sessions puissantes.",
  },
  {
    title: "Qualité de production",
    text: "Une attention constante aux détails, à l'optimisation et à l'expérience globale du joueur.",
  },
];

const members = [
  { role: "Directeur créatif", name: "Alya Voss" },
  { role: "Lead gameplay", name: "Kellan Rho" },
  { role: "Game designer", name: "Sora Mett" },
  { role: "Technical artist", name: "Nex Arin" },
  { role: "Programmeur principal", name: "Milo Hart" },
  { role: "Sound designer", name: "Elia Frost" },
];

const phases = [
  { label: "Phase 1", title: "Prototype", text: "Validation des mécaniques, de la sensation de jeu et de l'identité visuelle." },
  { label: "Phase 2", title: "Production", text: "Développement des systèmes, de la carte et de l'expérience de progression." },
  { label: "Phase 3", title: "Polissage", text: "Optimisation, équilibre, bruitages, effets visuels et préparation de la sortie." },
];
---

<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{teamName} | équipe de développement</title>
    <meta
      name="description"
      content="Page de présentation de l'équipe de développement de jeu vidéo DestinyForge."
    />
    <style>
      :root {
        --bg: #070d17;
        --bg-2: #0d1727;
        --panel: rgba(15, 26, 42, 0.9);
        --panel-border: rgba(143, 173, 255, 0.18);
        --text: #edf3ff;
        --muted: #aac0e4;
        --primary: #7c9cff;
        --primary-2: #60e0ff;
        --accent: #b98cff;
        --gold: #f7d37b;
        --shadow: rgba(7, 13, 23, 0.7);
      }

      * { box-sizing: border-box; }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        font-family: Inter, "Segoe UI", sans-serif;
        background:
          radial-gradient(circle at top left, rgba(124, 156, 255, 0.22), transparent 28%),
          radial-gradient(circle at right, rgba(96, 224, 255, 0.15), transparent 26%),
          linear-gradient(180deg, var(--bg) 0%, #0a1220 100%);
        color: var(--text);
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .container {
        width: min(1180px, calc(100% - 32px));
        margin: 0 auto;
      }

      .topbar {
        position: sticky;
        top: 0;
        z-index: 20;
        backdrop-filter: blur(12px);
        background: rgba(7, 13, 23, 0.62);
        border-bottom: 1px solid rgba(255,255,255,0.04);
      }

      .topbar-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 74px;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .brand-mark {
        width: 34px;
        height: 34px;
        border-radius: 12px;
        background: linear-gradient(135deg, var(--primary), var(--accent));
        display: grid;
        place-items: center;
        box-shadow: 0 0 30px rgba(124,156,255,0.4);
        font-size: 0.9rem;
      }

      .nav {
        display: flex;
        align-items: center;
        gap: 22px;
        color: var(--muted);
        font-size: 0.96rem;
      }

      .nav a:hover {
        color: var(--text);
      }

      .cta {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 46px;
        padding: 0 18px;
        border: 1px solid rgba(124,156,255,0.35);
        background: linear-gradient(135deg, rgba(124,156,255,0.18), rgba(96,224,255,0.08));
        border-radius: 999px;
        font-weight: 700;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }

      .cta:hover {
        transform: translateY(-1px);
        box-shadow: 0 12px 30px rgba(96,224,255,0.12);
      }

      .hero {
        padding: 72px 0 36px;
      }

      .hero-grid {
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        gap: 32px;
        align-items: center;
      }

      .eyebrow {
        display: inline-block;
        padding: 8px 12px;
        border: 1px solid rgba(124,156,255,0.25);
        background: rgba(124,156,255,0.08);
        border-radius: 999px;
        color: var(--primary-2);
        font-size: 0.75rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        margin-bottom: 18px;
      }

      h1 {
        margin: 0;
        font-size: clamp(2.8rem, 5vw, 5rem);
        line-height: 0.96;
        letter-spacing: -0.06em;
      }

      .gradient-text {
        background: linear-gradient(135deg, var(--primary-2), var(--primary), var(--accent));
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }

      .lead {
        max-width: 620px;
        color: var(--muted);
        font-size: 1.1rem;
        line-height: 1.7;
        margin: 22px 0 28px;
      }

      .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 30px;
      }

      .button-secondary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 46px;
        padding: 0 18px;
        border-radius: 999px;
        border: 1px solid rgba(255,255,255,0.12);
        background: rgba(255,255,255,0.02);
        color: var(--text);
        font-weight: 600;
      }

      .stats {
        display: grid;
        grid-template-columns: repeat(4, minmax(100px, 1fr));
        gap: 18px;
        margin-top: 20px;
      }

      .stat {
        background: rgba(255,255,255,0.02);
        border: 1px solid var(--panel-border);
        border-radius: 18px;
        padding: 16px 14px;
      }

      .stat strong {
        display: block;
        font-size: clamp(1.5rem, 3vw, 2.4rem);
        line-height: 1;
        margin-bottom: 8px;
      }

      .stat span {
        color: var(--muted);
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }

      .visual {
        position: relative;
        min-height: 520px;
        border-radius: 30px;
        overflow: hidden;
        background: linear-gradient(145deg, rgba(14,24,38,0.95), rgba(11,17,28,0.7));
        border: 1px solid var(--panel-border);
        box-shadow: 0 25px 55px var(--shadow);
      }

      .visual::before {
        content: "";
        position: absolute;
        inset: 20px 20px auto auto;
        width: 180px;
        height: 180px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(96,224,255,0.32), transparent 65%);
        filter: blur(8px);
      }

      .screen {
        position: absolute;
        inset: 24px;
        border-radius: 24px;
        border: 1px solid rgba(255,255,255,0.08);
        background:
          linear-gradient(180deg, rgba(124,156,255,0.15), rgba(11,17,28,0.75) 40%),
          linear-gradient(120deg, rgba(18,31,49,0.9), rgba(9,14,23,1));
        overflow: hidden;
      }

      .scanlines {
        position: absolute;
        inset: 0;
        background: repeating-linear-gradient(
          to bottom,
          rgba(255,255,255,0.025),
          rgba(255,255,255,0.025) 1px,
          transparent 1px,
          transparent 4px
        );
      }

      .hud {
        position: absolute;
        inset: 0;
        padding: 20px;
      }

      .hud-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        color: var(--muted);
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.12em;
      }

      .hud-pills {
        display: flex;
        gap: 10px;
        margin-top: 28px;
      }

      .pill {
        padding: 8px 10px;
        border-radius: 999px;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.06);
      }

      .map {
        position: absolute;
        left: 30px;
        right: 30px;
        bottom: 28px;
        height: 235px;
        border-radius: 18px;
        background:
          linear-gradient(180deg, rgba(12,18,30,0.8), rgba(12,18,30,0.4)),
          url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="600" height="400" viewBox="0 0 600 400"><rect width="600" height="400" fill="%23091019"/><path d="M70 300 C180 250, 240 240, 330 220 S510 120, 560 100" stroke="%237c9cff" stroke-width="2" fill="none" opacity="0.8"/><path d="M120 80 C180 170, 210 200, 330 260 S460 300, 600 330" stroke="%2360e0ff" stroke-width="2" fill="none" opacity="0.65"/><circle cx="255" cy="180" r="58" fill="none" stroke="%23f7d37b" stroke-width="2" fill-opacity="0.08"/><circle cx="420" cy="220" r="76" fill="none" stroke="%23b98cff" stroke-width="2" fill-opacity="0.08"/></svg>') center/cover;
        border: 1px solid rgba(124,156,255,0.18);
      }

      .orb {
        position: absolute;
        width: 18px;
        height: 18px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--gold), #ffd7a6);
        box-shadow: 0 0 24px rgba(247,211,123,0.8);
      }

      .orb.one { left: 160px; top: 120px; }
      .orb.two { right: 152px; top: 96px; }
      .orb.three { left: 220px; bottom: 54px; }

      .section {
        padding: 44px 0;
      }

      .section-head {
        display: flex;
        justify-content: space-between;
        align-items: end;
        gap: 20px;
        margin-bottom: 24px;
      }

      h2 {
        margin: 0;
        font-size: clamp(1.9rem, 3vw, 3rem);
        letter-spacing: -0.05em;
      }

      .section-note {
        color: var(--muted);
        max-width: 560px;
        line-height: 1.7;
      }

      .grid-3 {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 22px;
      }

      .card {
        background: rgba(11, 18, 28, 0.8);
        border: 1px solid var(--panel-border);
        border-radius: 22px;
        padding: 26px 22px;
        box-shadow: 0 14px 30px rgba(5,8,14,0.25);
      }

      .card .icon {
        width: 46px;
        height: 46px;
        border-radius: 14px;
        display: grid;
        place-items: center;
        margin-bottom: 18px;
        background: linear-gradient(135deg, rgba(124,156,255,0.2), rgba(96,224,255,0.08));
        border: 1px solid rgba(124,156,255,0.2);
        font-size: 1.3rem;
      }

      .card h3 {
        margin: 0 0 10px;
        font-size: 1.3rem;
      }

      .card p {
        margin: 0;
        color: var(--muted);
        line-height: 1.7;
      }

      .team-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 20px;
      }

      .member {
        position: relative;
        overflow: hidden;
        min-height: 220px;
        padding: 20px;
        border-radius: 22px;
        background:
          linear-gradient(180deg, rgba(17,29,46,0.9), rgba(11,17,28,0.92)),
          linear-gradient(135deg, rgba(124,156,255,0.18), rgba(185,140,255,0.14));
        border: 1px solid var(--panel-border);
      }

      .member::before {
        content: "";
        position: absolute;
        inset: -40% auto auto -10%;
        width: 140px;
        height: 140px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(124,156,255,0.22), transparent 62%);
      }

      .avatar {
        width: 62px;
        height: 62px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        font-weight: 800;
        background: linear-gradient(135deg, var(--primary), var(--accent));
        margin-bottom: 20px;
        position: relative;
        z-index: 1;
      }

      .member .label {
        display: inline-block;
        color: var(--primary-2);
        font-size: 0.68rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        margin-bottom: 8px;
      }

      .member h3 {
        margin: 0;
        font-size: 1.35rem;
      }

      .timeline {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 20px;
      }

      .phase {
        position: relative;
        padding-top: 18px;
      }

      .phase::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        height: 2px;
        background: linear-gradient(90deg, var(--primary), var(--accent));
      }

      .phase .tag {
        display: inline-block;
        margin: 18px 0 12px;
        color: var(--gold);
        font-size: 0.7rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .phase h3 {
        margin: 0 0 10px;
        font-size: 1.4rem;
      }

      .phase p {
        margin: 0;
        color: var(--muted);
        line-height: 1.75;
      }

      .cta-panel {
        margin-top: 32px;
        padding: 30px 26px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        background: linear-gradient(135deg, rgba(124,156,255,0.12), rgba(185,140,255,0.08));
        border: 1px solid rgba(124,156,255,0.2);
        border-radius: 26px;
      }

      .cta-panel h3 {
        margin: 0 0 8px;
        font-size: clamp(1.6rem, 2vw, 2.2rem);
      }

      .cta-panel p {
        margin: 0;
        color: var(--muted);
      }

      footer {
        padding: 30px 0 70px;
        color: var(--muted);
        text-align: center;
      }

      @media (max-width: 900px) {
        .hero-grid,
        .grid-3,
        .team-grid,
        .timeline,
        .cta-panel {
          grid-template-columns: 1fr;
          display: grid;
        }

        .nav {
          display: none;
        }

        .hero {
          padding-top: 46px;
        }

        .visual {
          min-height: 420px;
        }

        .stats {
          grid-template-columns: repeat(2, minmax(120px, 1fr));
        }
      }

      @media (max-width: 560px) {
        .stats {
          grid-template-columns: 1fr 1fr;
        }

        h1 {
          font-size: 3rem;
        }
      }
    </style>
  </head>

  <body>
    <header class="topbar">
      <div class="container topbar-inner">
        <a href="#top" class="brand" aria-label="DestinyForge">
          <span class="brand-mark">D</span>
          <span>{teamName}</span>
        </a>

        <nav class="nav" aria-label="Navigation principale">
          <a href="#mission">Mission</a>
          <a href="#valeurs">Valeurs</a>
          <a href="#equipe">Équipe</a>
          <a href="#progres">Progression</a>
        </nav>

        <a href="#contact" class="cta">Rejoindre le projet</a>
      </div>
    </header>

    <main id="top">
      <section class="hero">
        <div class="container hero-grid">
          <div>
            <div class="eyebrow">Studio de création</div>
            <h1>
              Forgeons des <span class="gradient-text">mondes</span><br />
              qui marquent la mémoire.<br />
            </h1>
            <p class="lead">
              DestinyForge est une équipe de développement de jeux vidéo passionnée par la création
              d'expériences immersives, ambitieuses et profondément humaines. Nous concevons des titres
              où le gameplay, la narration et l'émotion s'entrelacent pour donner vie à des univers
              mémorables.
            </p>

            <div class="hero-actions">
              <a href="#mission" class="cta">Découvrir notre vision</a>
              <a href="#equipe" class="button-secondary">Rencontrer l'équipe</a>
            </div>

            <div class="stats" aria-label="Statistiques du studio">
              {stats.map((item) => (
                <div class="stat">
                  <strong>{item.value}</strong>
                  <span>{item.label}</span>
                </div>
              ))}
            </div>
          </div>

          <div class="visual" aria-label="Illustration du jeu">
            <div class="screen">
              <div class="scanlines"></div>
              <div class="hud">
                <div class="hud-top">
                  <span>DestinyForge</span>
                  <span>Zone 09</span>
                </div>
                <div class="hud-pills">
                  <span class="pill">RPG</span>
                  <span class="pill">Action</span>
                  <span class="pill">Narratif</span>
                </div>
              </div>
              <div class="map">
                <span class="orb one"></span>
                <span class="orb two"></span>
                <span class="orb three"></span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="mission" class="section">
        <div class="container">
          <div class="section-head">
            <h2>Notre mission</h2>
            <div class="section-note">
              Créer des jeux qui transcendent le simple divertissement pour devenir des expériences
              inoubliables, ancrées dans l'émotion, le défi et la découverte.
            </div>
          </div>

          <div class="grid-3">
            {pillars.map((pillar) => (
              <article class="card">
                <div class="icon">✦</div>
                <h3>{pillar.title}</h3>
                <p>{pillar.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="valeurs" class="section">
        <div class="container">
          <div class="section-head">
            <h2>Les valeurs qui guident notre équipe</h2>
          </div>

          <div class="grid-3">
            <article class="card">
              <div class="icon">⚔</div>
              <h3>Ambition</h3>
              <p>Nous visons des projets d'envergure, sans jamais sacrifier la cohérence artistique ou la qualité.</p>
            </article>

            <article class="card">
              <div class="icon">◎</div>
              <h3>Collaboration</h3>
              <p>Les idées naissent de la discussion, de l'expérimentation, et de la rencontre entre talents.</p>
            </article>

            <article class="card">
              <div class="icon">✧</div>
              <h3>Excellence</h3>
              <p>Chaque décision est pensée pour servir le jeu, l'expérience du joueur et la vision globale du studio.</p>
            </article>
          </div>
        </div>
      </section>

      <section id="equipe" class="section">
        <div class="container">
          <div class="section-head">
            <h2>Une équipe de créateurs engagés</h2>
            <div class="section-note">
              Une composition multidisciplinaire où la passion du jeu vidéo se conjugue avec la rigueur du développement.
            </div>
          </div>

          <div class="team-grid">
            {members.map((member) => (
              <article class="member">
                <div class="avatar">{member.name.split(" ").map((part) => part[0]).slice(0, 2).join("")}</div>
                <span class="label">{member.role}</span>
                <h3>{member.name}</h3>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="progres" class="section">
        <div class="container">
          <div class="section-head">
            <h2>Progression du projet</h2>
            <div class="section-note">
              Nous construisons notre vision par étapes, avec une méthode claire et une concentration sur la qualité.
            </div>
          </div>

          <div class="timeline">
            {phases.map((phase) => (
              <article class="phase">
                <span class="tag">{phase.label}</span>
                <h3>{phase.title}</h3>
                <p>{phase.text}</p>
              </article>
            ))}
          </div>

          <div id="contact" class="cta-panel">
            <div>
              <h3>Prêts à créer le prochain grand moment vidéoludique ?</h3>
              <p>DestinyForge cherche à développer des idées fortes, des partenariats significatifs et une communauté engagée.</p>
            </div>
            <a href="mailto:contact@destinyforge.dev" class="cta">contact@destinyforge.dev</a>
          </div>
        </div>
      </section>
    </main>

    <footer>
      © 2025 DestinyForge — We build worlds worth living in.
    </footer>
  </body>
</html>
